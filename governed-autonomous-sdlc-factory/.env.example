# ============================================================
# Governed Autonomous SDLC Factory - Environment Configuration
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://governance:forge@localhost:5432/sdlc_factory

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sdlc_memory

# GitHub (optional - system works without it)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Local AI - LM Studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Claude (optional)
CLAUDE_API_KEY=

# Model Provider Configuration
DEFAULT_MODEL_PROVIDER=local
LOCAL_ONLY_MODE=true

# Cost Controls
COST_HARD_LIMIT=50.00
COST_WARNING_THRESHOLD=0.8

# Memory Integrations
OBSIDIAN_VAULT_PATH=/Users/marcovanhune/Documents/HERMES_OBSIDIAN
OMI_API_URL=
OMI_API_KEY=

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production
API_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# Deployment
DEPLOYMENT_BASE_PORT=9000
DOCKER_NETWORK=sdlc-factory

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
